{
  "name": "betaflight-blackbox-explorer",
  "productName": "Blackbox Explorer",
  "displayName": "Betaflight - Blackbox Explorer",
  "description": "Crossplatform blackbox analitics tool for Betaflight flight control system.",
  "version": "2025.12.1",
  "main": "electron/main.js",
  "default_locale": "en",
  "scripts": {
    "start": "vite",
    "build": "node scripts/build-all.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "electron:dev": "npm run build && electron .",
    "download:ffmpeg": "node scripts/download-ffmpeg.js",
    "electron:build": "npm run download:ffmpeg && npm run build && electron-builder --config electron-builder.yml",
    "build:fast": "npm run build && electron-builder --config electron-builder.yml --dir"
  },
  "repository": {
    "type": "git",
    "url": "github.com/betaflight/blackbox-log-viewer"
  },
  "author": "The Betaflight open source project.",
  "license": "GPL-3.0",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "bootstrap": "~3.4.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^8.5.0",
    "html2canvas": "^1.0.0-rc.5",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.13.2",
    "leaflet": "^1.9.3",
    "leaflet-marker-rotation": "^0.4.0",
    "Leaflet.MultiOptionsPolyline": "hgoebl/Leaflet.MultiOptionsPolyline",
    "lodash": "^4.17.23",
    "prettier": "^2.8.1",
    "throttle-debounce": "^5.0.0",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "inflection": "1.12.0",
    "yarn": "^1.22.0"
  },
  "resolutions": {
    "**/**/lodash.template": "^4.5.0"
  },
  "engines": {
    "node": "24.x"
  }
}
